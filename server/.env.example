# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=4000
NODE_ENV=development

# MongoDB — local, or a free MongoDB Atlas cluster connection string
# Atlas example: mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/hunarhub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hunarhub

# Auth — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (your Vercel URL + local dev)
CLIENT_ORIGIN=http://localhost:5173,https://hunarhub-eight.vercel.app

# Cloudinary — powers listing image uploads (server/src/config/cloudinary.ts).
# Optional: without these, every other route still works fine; only the
# image-upload endpoints return a clear 503 instead of crashing the server.
# Get these from your Cloudinary dashboard (cloudinary.com → Dashboard).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
