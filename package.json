{
  "name": "hunarhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HunarHub — a digital marketplace that gives local micro-entrepreneurs (cobblers, potters, tailors, artisans, vendors) digital visibility and direct access to customers.",
  "scripts": {
